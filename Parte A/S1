.data
N:      .word 1000
array:  .space 8000

.text
.globl main
main:
    la $t0, array
    lw $t1, N
    li $t2, 0

init_loop:
    bge $t2, $t1, init_end
    sll $t3, $t2, 3
    add $t4, $t0, $t3
    mtc1 $t2, $f0
    cvt.d.w $f0, $f0
    sdc1 $f0, 0($t4)
    addi $t2, $t2, 1
    j init_loop

init_end:
    li $t2, 0
    mtc1 $zero, $f2
    mtc1 $zero, $f3

read_loop:
    bge $t2, $t1, read_end
    sll $t3, $t2, 3
    add $t4, $t0, $t3
    ldc1 $f0, 0($t4)
    add.d $f2, $f2, $f0
    addi $t2, $t2, 1
    j read_loop

read_end:
    li $t2, 0

write_loop:
    bge $t2, $t1, end
    sll $t3, $t2, 3
    add $t4, $t0, $t3
    sll $t5, $t2, 1
    mtc1 $t5, $f0
    cvt.d.w $f0, $f0
    sdc1 $f0, 0($t4)
    addi $t2, $t2, 1
    j write_loop

end:
    li $v0, 10
    syscall
